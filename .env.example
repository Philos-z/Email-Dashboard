# Copy to .env. Each installation owns a separate private directory.
ATLAS_BIND=127.0.0.1
ATLAS_PORT=8765
ATLAS_REQUIRE_LOGIN=1
# ATLAS_DATA_DIR=/absolute/path/to/private-email-dashboard-data
ATLAS_TIMEZONE=Europe/Berlin
ATLAS_MCP_SERVER=codex_apps
# ATLAS_CODEX_BIN=/absolute/path/to/codex
# Set to 1 only behind HTTPS; enables Secure cookies.
ATLAS_HTTPS=0
